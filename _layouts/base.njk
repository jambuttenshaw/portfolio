<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>{% if title %}{{ title }} | {% endif %}Jamie Buttenshaw</title>
  <script>
    // Apply the saved theme (or "follow system" on first visit) before the
    // first paint, so navigating between pages never flashes the wrong theme.
    // 'system' needs no OS sniffing here: the CSS media query and the
    // color-scheme property resolve it at paint time.
    (function () {
      try {
        var saved = window.localStorage.getItem('portfolio-theme');
        var state = (saved === 'light' || saved === 'dark' || saved === 'system')
          ? saved
          : 'system';
        var root = document.documentElement;
        root.setAttribute('data-theme', state);
        root.style.colorScheme = state === 'system' ? 'light dark' : state;
      } catch (e) {
        // localStorage unavailable: the CSS default applies, main.js takes over
      }
    })();
  </script>
  <link rel="stylesheet" href="/css/font-awesome.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <nav>
      <a href="/" class="nav-brand"><h1>Jamie Buttenshaw</h1></a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li>
          <!-- Theme selector: one of three options, the selected one highlighted.
               The static default (system) matches the first-visit state. -->
          <div id="theme-toggle" class="theme-toggle" role="group" aria-label="Theme">
            <button class="theme-option" type="button" data-theme-choice="light" aria-pressed="false" aria-label="Light theme">
              <i class="fa fa-sun-o" aria-hidden="true"></i>
            </button>
            <button class="theme-option" type="button" data-theme-choice="dark" aria-pressed="false" aria-label="Dark theme">
              <i class="fa fa-moon-o" aria-hidden="true"></i>
            </button>
            <button class="theme-option selected" type="button" data-theme-choice="system" aria-pressed="true" aria-label="Follow system theme">
              <i class="fa fa-desktop" aria-hidden="true"></i>
            </button>
          </div>
        </li>
      </ul>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <p>&copy; Jamie Buttenshaw {{ "" | year }}</p>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>